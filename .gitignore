# Datasets — large, downloaded from Roboflow, not meant to live in git
datasets/
data/

# Training outputs — large, regenerable by re-running training
runs/

# Pretrained base weights auto-downloaded by ultralytics (re-fetched on demand)
yolov8*.pt

# Smoke-test metrics — throwaway (1 epoch on a data fraction), not deliverables
results/metrics/smoke_*.csv

# Review artifacts from label_safe_unsafe.py (regenerable from datasets/ + the script)
review_images/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment / secrets — never commit a Roboflow API key
.env

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Jupyter checkpoints
.ipynb_checkpoints/
